{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "g1-adoption-manifest.schema.json",
 "title": "G1 upstream adoption manifest",
 "type": "object",
 "required": ["schema", "generated_by", "identity", "policy", "inputs", "cores"],
 "properties": {
  "schema": {"const": 1},
  "generated_by": {"const": "tools/build_adoption_manifest.py"},
  "identity": {"const": "core + even virtual address"},
  "policy": {
   "type": "object",
   "required": ["private_sdc_requires_per_va_machine_unique_identity", "default_on_ambiguity"],
   "properties": {
    "private_sdc_requires_per_va_machine_unique_identity": {"const": true},
    "default_on_ambiguity": {"const": "retain_reconstruction"}
   }
  },
  "inputs": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["path", "sha256"],
    "properties": {
     "path": {"type": "string"},
     "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    }
   }
  },
  "cores": {
   "type": "object",
   "required": ["app", "net"],
   "properties": {
    "app": {"$ref": "#/$defs/core"},
    "net": {"$ref": "#/$defs/core"}
   }
  }
 },
 "$defs": {
  "core": {
   "type": "object",
   "required": ["summary", "entries"],
   "properties": {
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}}
   }
  },
  "entry": {
   "type": "object",
   "required": ["core", "va", "raw_symbol", "kind", "component", "exclude_reconstruction", "decision", "evidence"],
   "properties": {
    "core": {"enum": ["app", "net"]},
    "va": {"type": "string", "pattern": "^0x[0-9a-f]{8}$"},
    "raw_symbol": {"type": "string", "pattern": "^FUN_[0-9a-f]{8}$"},
    "kind": {"enum": ["source", "archive", "static_helper", "table", "glue"]},
    "exclude_reconstruction": {"type": "boolean"},
    "decision": {"enum": ["adopt_upstream_exclude_reconstruction", "retain_reconstruction"]},
    "evidence": {"type": "array", "minItems": 1}
   }
  }
 }
}
